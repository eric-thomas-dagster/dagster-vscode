{
  "name": "dagster-power-user",
  "displayName": "Dagster Power User",
  "description": "Standalone Dagster development in VS Code: asset/dbt lineage, hover & go-to-definition, dg check diagnostics, AI component authoring, and a dagster-expert assistant with MCP tool access. No external backend required.",
  "version": "0.0.1",
  "publisher": "dagsterlabs",
  "repository": {
    "type": "git",
    "url": "https://github.com/eric-thomas-dagster/dagster-vscode.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/dagster.yaml",
    "workspaceContains:**/pyproject.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dagsterPowerUser",
          "title": "Dagster",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "dagsterPowerUser": [
        {
          "type": "webview",
          "id": "dagsterPowerUser.chat",
          "name": "Dagster Expert"
        },
        {
          "id": "dagsterPowerUser.projectComponents",
          "name": "Dagster Definitions",
          "visibility": "collapsed"
        },
        {
          "id": "dagsterPowerUser.componentCatalog",
          "name": "Community Components",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "dagsterPowerUser.showDetectedProjects",
        "title": "Dagster: Show Detected Projects",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.refreshProjectDetection",
        "title": "Dagster: Refresh Project Detection",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.showAssetLineage",
        "title": "Dagster: Show Asset Lineage",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.devServerMenu",
        "title": "Dagster: Dev Server...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.refreshAssetIndex",
        "title": "Dagster: Refresh Asset Index",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.runDgCheck",
        "title": "Dagster: Run dg check defs",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.setAnthropicApiKey",
        "title": "Dagster: Set Anthropic API Key",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.setOpenAiApiKey",
        "title": "Dagster: Set OpenAI API Key",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.scaffoldNewProject",
        "title": "Dagster: Scaffold New Project",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.searchComponentCatalog",
        "title": "Dagster: Search Component Catalog",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.materializeAssetSearch",
        "title": "Dagster: Materialize Asset...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.launchJobSearch",
        "title": "Dagster: Launch Job...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.searchDocs",
        "title": "Dagster: Search Docs",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.scaffoldGithubActions",
        "title": "Dagster: Scaffold GitHub Actions",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.newChatSession",
        "title": "Dagster: New Chat Session",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.showChatHistory",
        "title": "Dagster: Show Chat History",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.showMoreActions",
        "title": "Dagster: More Actions...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.setDagsterPlusCredentials",
        "title": "Dagster: Connect Dagster+...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.showDagsterPlusUsage",
        "title": "Dagster: Show Dagster+ Usage",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.fixDiagnosticWithAi",
        "title": "Dagster: Ask Dagster Expert to Fix This",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.manageAutomations",
        "title": "Dagster: Manage Schedules & Sensors",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.setupDagsterPlusMcp",
        "title": "Dagster: Set Up Dagster+ MCP Server",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.switchTarget",
        "title": "Dagster: Switch Target (Local / Remote)...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.showRunExplorer",
        "title": "Dagster: Show Runs",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.openAssetInDagster",
        "title": "Open in Dagster",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.materializeAssetFromTree",
        "title": "Materialize Asset",
        "category": "Dagster",
        "icon": "$(play)"
      },
      {
        "command": "dagsterPowerUser.launchJobFromTree",
        "title": "Launch Job",
        "category": "Dagster",
        "icon": "$(play)"
      },
      {
        "command": "dagsterPowerUser.startAutomationFromTree",
        "title": "Start",
        "category": "Dagster",
        "icon": "$(debug-start)"
      },
      {
        "command": "dagsterPowerUser.stopAutomationFromTree",
        "title": "Stop",
        "category": "Dagster",
        "icon": "$(debug-pause)"
      },
      {
        "command": "dagsterPowerUser.showLoadError",
        "title": "Dagster: Show Load Error",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.setDefaultStatusInCode",
        "title": "Dagster: Set Default Status in Code",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.addFolderDependency",
        "title": "Dagster: Add Dependency to Folder...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.addAssetDependency",
        "title": "Dagster: Add Dependency...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.setAssetGroup",
        "title": "Dagster: Set Group...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.addAssetToJob",
        "title": "Dagster: Add to Job...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.addAssetCheck",
        "title": "Dagster: Add Check...",
        "category": "Dagster"
      },
      {
        "command": "dagsterPowerUser.addScheduleForJob",
        "title": "Dagster: Add Schedule...",
        "category": "Dagster"
      }
    ],
    "languageModelTools": [
      {
        "name": "dagster_list_assets",
        "displayName": "List Dagster Assets",
        "modelDescription": "Lists every asset in the currently active Dagster target (Local, a remote Dagster OSS deployment, or Dagster+), including its key, group, kinds, description, and upstream dependencies.",
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "dagster_list_runs",
        "displayName": "List Dagster Runs",
        "modelDescription": "Lists recent Dagster runs for the currently active target, with status, job name, and timing.",
        "inputSchema": {
          "type": "object",
          "properties": { "limit": { "type": "number", "description": "Max runs to return, default 20" } }
        }
      },
      {
        "name": "dagster_get_run_logs",
        "displayName": "Get Dagster Run Logs",
        "modelDescription": "Fetches structured event logs for a specific Dagster run by its run ID, including failure messages/tracebacks.",
        "inputSchema": {
          "type": "object",
          "properties": { "runId": { "type": "string", "description": "The run ID to fetch logs for" } },
          "required": ["runId"]
        }
      },
      {
        "name": "dagster_list_schedules_and_sensors",
        "displayName": "List Dagster Schedules & Sensors",
        "modelDescription": "Lists every schedule and sensor in the currently active Dagster target, with its current running/stopped status.",
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "dagster_materialize_asset",
        "displayName": "Materialize Dagster Asset",
        "modelDescription": "Launches a real Dagster run to materialize a specific asset by its key, against the currently active target. This has real side effects.",
        "inputSchema": {
          "type": "object",
          "properties": { "assetKey": { "type": "string", "description": "The asset key, e.g. \"models/stg_customers\"" } },
          "required": ["assetKey"]
        }
      },
      {
        "name": "dagster_launch_job",
        "displayName": "Launch Dagster Job",
        "modelDescription": "Launches a real Dagster run for a named job, against the currently active target. This has real side effects.",
        "inputSchema": {
          "type": "object",
          "properties": { "jobName": { "type": "string", "description": "The job's name" } },
          "required": ["jobName"]
        }
      },
      {
        "name": "dagster_terminate_run",
        "displayName": "Terminate Dagster Run",
        "modelDescription": "Terminates a currently running Dagster run by its run ID. This has real side effects and cannot be undone.",
        "inputSchema": {
          "type": "object",
          "properties": { "runId": { "type": "string", "description": "The run ID to terminate" } },
          "required": ["runId"]
        }
      },
      {
        "name": "dagster_retry_run",
        "displayName": "Retry Dagster Run",
        "modelDescription": "Re-executes a finished Dagster run (e.g. one that failed) as a new run, by its run ID. This has real side effects.",
        "inputSchema": {
          "type": "object",
          "properties": { "runId": { "type": "string", "description": "The run ID to retry/re-execute" } },
          "required": ["runId"]
        }
      },
      {
        "name": "dagster_toggle_automation",
        "displayName": "Start/Stop Dagster Schedule or Sensor",
        "modelDescription": "Starts or stops a schedule or sensor by name, against the currently active target. This has real side effects.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "description": "The schedule or sensor's name" },
            "kind": { "type": "string", "enum": ["schedule", "sensor"] },
            "action": { "type": "string", "enum": ["start", "stop"] }
          },
          "required": ["name", "kind", "action"]
        }
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "dagsterPowerUser.materializeAssetFromTree",
          "when": "view == dagsterPowerUser.projectComponents && viewItem == dagsterAsset",
          "group": "inline"
        },
        {
          "command": "dagsterPowerUser.launchJobFromTree",
          "when": "view == dagsterPowerUser.projectComponents && viewItem == dagsterjob",
          "group": "inline"
        },
        {
          "command": "dagsterPowerUser.startAutomationFromTree",
          "when": "view == dagsterPowerUser.projectComponents && (viewItem == dagsterscheduleStopped || viewItem == dagstersensorStopped)",
          "group": "inline"
        },
        {
          "command": "dagsterPowerUser.stopAutomationFromTree",
          "when": "view == dagsterPowerUser.projectComponents && (viewItem == dagsterscheduleRunning || viewItem == dagstersensorRunning)",
          "group": "inline"
        },
        {
          "command": "dagsterPowerUser.openAssetInDagster",
          "when": "view == dagsterPowerUser.projectComponents && viewItem == dagsterAsset"
        },
        {
          "command": "dagsterPowerUser.addAssetDependency",
          "when": "view == dagsterPowerUser.projectComponents && viewItem == dagsterAsset"
        },
        {
          "command": "dagsterPowerUser.setAssetGroup",
          "when": "view == dagsterPowerUser.projectComponents && viewItem == dagsterAsset"
        },
        {
          "command": "dagsterPowerUser.addAssetToJob",
          "when": "view == dagsterPowerUser.projectComponents && viewItem == dagsterAsset"
        },
        {
          "command": "dagsterPowerUser.addAssetCheck",
          "when": "view == dagsterPowerUser.projectComponents && viewItem == dagsterAsset"
        },
        {
          "command": "dagsterPowerUser.addScheduleForJob",
          "when": "view == dagsterPowerUser.projectComponents && viewItem == dagsterjob"
        }
      ],
      "explorer/context": [
        {
          "command": "dagsterPowerUser.addFolderDependency",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        }
      ]
    },
    "configuration": {
      "title": "Dagster Power User",
      "properties": {
        "dagsterPowerUser.dgPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the `dg` CLI executable. Leave blank to resolve from PATH (or the active Python interpreter's environment)."
        },
        "dagsterPowerUser.devServerUrl": {
          "type": "string",
          "default": "",
          "description": "Override the dg dev/dagster dev GraphQL endpoint. Leave blank to use http://localhost:3000/graphql."
        },
        "dagsterPowerUser.aiProvider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai"
          ],
          "default": "anthropic",
          "description": "LLM provider for the AI planner and Dagster Expert assistant."
        },
        "dagsterPowerUser.aiModel": {
          "type": "string",
          "default": "",
          "description": "Override the model id. Leave blank for the default (claude-sonnet-5 for Anthropic)."
        },
        "dagsterPowerUser.dagsterPlusOrg": {
          "type": "string",
          "default": "",
          "description": "Dagster+ organization slug (e.g. \"my-org\" from my-org.dagster.cloud). The API token itself is set separately via 'Dagster: Connect Dagster+...' and stored securely, never here."
        },
        "dagsterPowerUser.dagsterPlusDeployment": {
          "type": "string",
          "default": "",
          "description": "Override the Dagster+ deployment name to query. Leave blank to use \"prod\"."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "npm run build --prefix webview-ui",
    "compile": "node esbuild.js && npm run build:webview",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production && npm run build:webview && npx @vscode/vsce package",
    "typecheck": "tsc --noEmit -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
